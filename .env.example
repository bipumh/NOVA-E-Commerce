# ───────────────────────────────────────────────────────────────
# NOVA — environment variables
#
# Copy this file to `.env.local` and fill in your real values.
# `.env*` is git-ignored, so your keys stay out of the repository.
# The storefront runs fully on bundled placeholder data while these are unset.
# ───────────────────────────────────────────────────────────────

# --- Supabase (required for any backend usage) -----------------
# Public values, safe to ship to the browser. Find them in your
# Supabase project under Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Supabase service role (SERVER-ONLY, optional for now) ------
# Used exclusively by server-side admin operations (seeding, privileged
# queries, order fulfillment). Bypasses Row Level Security.
#
# IMPORTANT: NEVER prefix this with NEXT_PUBLIC_ and NEVER reference it from
# client code. It is only read in `src/lib/supabase/admin.ts`, which is marked
# `server-only`.
#
# Uncomment once you need server-side admin tooling:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Stripe (SERVER-ONLY) --------------------------------------
# Used by the server-side Checkout Session and webhook code.
# Find them in the Stripe Dashboard (Developers → API keys) and the
# webhook endpoint's signing secret.
#
# IMPORTANT: NEVER prefix these with NEXT_PUBLIC_ and NEVER reference
# them from client code.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Demo payment mode (optional, for showcases only) -----------
# When "true", checkout simulates a successful payment on the server
# (no Stripe required) and marks the order "paid".
# When "false" (or unset), the real Stripe Checkout flow is used.
DEMO_PAYMENT_MODE=false
